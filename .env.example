# Obrigatorio em producao: configure um valor longo e aleatorio na aba Variables da Railway.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
SERVICE_AUTH_TOKEN=troque-por-um-token-interno-longo-e-aleatorio

# Login com Google (OAuth 2.0). Crie um cliente do tipo "Aplicação da Web"
# no Google Cloud e cadastre exatamente a URL de retorno abaixo.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# URL pública da aplicação. Em produção, use seu domínio HTTPS sem barra final.
# APP_BASE_URL=https://seu-dominio.example

# Opcional localmente. Na Railway, o Volume define este caminho automaticamente.
# DATA_DIR=./data

# Redis usado pelos serviços que precisam de estado/cache compartilhado.
# REDIS_URL=redis://localhost:6379

# MinIO local (API S3 em http://localhost:9000; console em http://localhost:9001).
# MINIO_ROOT_USER=reusa-local
# MINIO_ROOT_PASSWORD=troque-por-uma-senha-local-segura
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_BUCKET=reusa
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_BASE_URL=http://localhost:9000
# S3_BUCKET=reusa
# S3_ACCESS_KEY_ID=reusa-local
# S3_SECRET_ACCESS_KEY=troque-por-uma-senha-local-segura

# Ativa a publicação distribuída. O Docker Compose define este valor sozinho.
# AMQP_URL=amqp://localhost:5672
# EVENT_EXCHANGE=reusa.events

# PostgreSQL usado na migração do núcleo para o banco relacional.
# POSTGRES_PASSWORD=troque-por-uma-senha-local-segura
# DATABASE_PROVIDER=sqlite
# Use DATABASE_PROVIDER=postgres together with POSTGRES_URL (or Railway's
# DATABASE_URL) to share
# notification and impact state across service replicas.
# RABBITMQ_USER=reusa
# RABBITMQ_PASSWORD=troque-por-uma-senha-local-segura
# AMQP_URL=amqp://reusa:senha@localhost:5672
# POSTGRES_URL=postgres://reusa:sua-senha@localhost:5432/reusa
